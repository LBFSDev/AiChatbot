model User {
  id        String   @id @default(uuid())
  email     String   @unique
  chats     Chat[]
  documents Document[]
}

model Chat {
  id        String @id @default(uuid())
  userId    String
  messages  Message[]
}

model Message {
  id       String @id @default(uuid())
  chatId   String
  role     String
  content  String
}

model Document {
  id        String @id @default(uuid())
  userId    String
  filename  String
  url       String
  createdAt DateTime @default(now())
}